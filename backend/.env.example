# Server Configuration
PORT=5000
NODE_ENV=development

# Client CORS Origin
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection URL
# Example: postgresql://postgres:postgres@localhost:5432/packaged_commodity_compliance
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sih_packaged_commodities

# Google Cloud Vision OCR (Optional for Mock Mode)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Storage path for local uploaded package images
UPLOAD_DIR=./uploads
